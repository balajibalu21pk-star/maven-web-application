node 
{   
    def mavenHome = tool name: "maven 3.8.1"
    properties([pipelineTriggers([pollSCM('* * * * *')])])
    stage('Checkout Code')
    {
        git branch: 'development', credentialsId: 'cadda636-d8e9-4e80-82ae-c8a122c6cdb1', url: 'https://github.com/balajibalu21pk-star/maven-web-application.git'
    }
    stage('Build')
    {
        sh  "${mavenHome}/bin/mvn clean package"
    }
    stage('Sonarcube Report')
    {
        sh  "${mavenHome}/bin/mvn sonar:sonar"
    }
    stage('Artifact Into Nexus')
    {
        sh  "${mavenHome}/bin/mvn deploy"
    }
    stage('DeployappintoTomcat')
    {
    sshagent(['6feb2ddc-2396-43f3-ab20-3bd4e8fb8d1c']) {
    sh "scp -o StrictHostKeyChecking=no target/maven-web-application.war ec2-user@13.126.240.182:/opt/tomcat/webapps"
    }    
    }
    
}
